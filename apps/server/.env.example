# ---------------------------------------------------------------------------
# QueryRank server configuration. Copy this file to `.env` and fill it in.
# `.env` is git-ignored — your real secrets never enter the repository.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Your own Postgres. The docker-compose.yml at the repo root starts one that
# matches this default connection string.
DATABASE_URL=postgres://queryrank:queryrank@localhost:5433/queryrank

# A long random string. Signs session cookies and (later) encrypts stored
# integration tokens at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

PORT=3000

# In development the SPA runs on :5173 and proxies /api to this server, so the
# OAuth redirect lives on the SPA origin. In production set this to your domain.
OAUTH_REDIRECT_BASE=http://localhost:5173

# --- Access control ---------------------------------------------------------
# Optional. When set, ONLY this email may register / sign in (single-user
# instance). Leave it BLANK to allow open signup — anyone can create an account.
ALLOWED_EMAIL=you@gmail.com

# --- Google OAuth -----------------------------------------------------------
# Register your OWN OAuth app at https://console.cloud.google.com
#   APIs & Services > Credentials > Create credentials > OAuth client ID
#   Application type: Web application
#   Authorized redirect URI: ${OAUTH_REDIRECT_BASE}/api/auth/google/callback
#     (e.g. http://localhost:5173/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---------------------------------------------------------
# Used to send the password-reset link. Optional — leave blank to run with
# Google sign-in only; the reset flow is disabled until both are set.
# Create a key at https://resend.com > API Keys, and verify your sending
# domain under https://resend.com > Domains.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend.
EMAIL_FROM=QueryRank <noreply@yourdomain.com>
