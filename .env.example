# QueryRank — environment for `docker compose up`.
# Copy this file to `.env` and fill in the values:   cp .env.example .env
#
# docker compose reads this .env automatically for the variables below.
# (Postgres runs inside the stack — you do NOT set DATABASE_URL here.)

# A long random secret. Used to sign sessions AND derive the encryption key for
# stored OAuth tokens. Generate one:  openssl rand -hex 32
APP_SECRET=

# The single Google account allowed to sign in to this instance (your email).
ALLOWED_EMAIL=you@example.com

# The public URL this app is served at — must match your Google OAuth redirect.
# For local use leave the default; for a server set it to your https domain.
OAUTH_REDIRECT_BASE=http://localhost:3000

# Your own Google OAuth 2.0 credentials (Web application).
# Authorized redirect URI to register in Google Cloud Console:
#   ${OAUTH_REDIRECT_BASE}/api/auth/google/callback
# Enable the "Google Search Console API" and "Google Analytics Data API".
# Leave blank to run with email sign-in + CSV import only (no live Google data).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host port to expose the app on (defaults to 3000).
APP_PORT=3000
